<nav class="navbar">
      <div class="nav-container">
        <%= link_to root_path, class: "nav-brand" do %>
          <i class="fa-solid fa-brain"></i>
          <span>SkillCert<strong>AI</strong></span>
        <% end %>

        <div class="nav-links">
          <% if user_signed_in? %>
            <%= link_to account_path, class: "nav-item" do %>
