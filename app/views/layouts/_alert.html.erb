<div class="flash-messages">
      <% if notice %>
        <div class="flash flash-notice">
          <i class="fa-solid fa-circle-check"></i> <%= notice %>
        </div>
      <% end %>
      <% if alert %>
        <div class="flash flash-alert">
          <i class="fa-solid fa-circle-exclamation"></i> <%= alert %>
        </div>
      <% end %>
</div>
